{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[{"file_id":"1pWTGPu5GOBgXjuMf41PB6yOlotWH87_S","timestamp":1789022110672}],"authorship_tag":"ABX9TyPowwPH0/hnxzKeXra8mkOU"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","source":["!pip install -q -U google-genai"],"metadata":{"id":"toMMcdcSRR2m"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# ============================================================\n","# HRBai\n","# ============================================================\n","\n","!pip install -q -U google-genai requests\n","\n","\n","# ============================================================\n","# UTF-8設定\n","# ============================================================\n","\n","import os\n","import sys\n","import locale\n","\n","os.environ[\"PYTHONIOENCODING\"] = \"utf-8\"\n","os.environ[\"LANG\"] = \"C.UTF-8\"\n","os.environ[\"LC_ALL\"] = \"C.UTF-8\"\n","\n","try:\n","    sys.stdout.reconfigure(encoding=\"utf-8\")\n","    sys.stderr.reconfigure(encoding=\"utf-8\")\n","except:\n","    pass\n","\n","\n","# ============================================================\n","# ライブラリ\n","# ============================================================\n","\n","from google import genai\n","import requests\n","import json\n","\n","\n","# ============================================================\n","# API設定\n","# ============================================================\n","\n","GEMINI_API_KEY = \"Gemini API\"\n","\n","CLOUDFLARE_API_TOKEN = \"Cloudflare API\"\n","\n","CLOUDFLARE_ACCOUNT_ID = \"Cloudflare ID\"\n","\n","\n","# ============================================================\n","# gemini\n","# ============================================================\n","\n","gemini_client = genai.Client(\n","    api_key=GEMINI_API_KEY\n",")\n","\n","\n","# ============================================================\n","# Cloudflare\n","# ============================================================\n","\n","CLOUDFLARE_URL = (\n","    f\"https://api.cloudflare.com/client/v4/accounts/\"\n","    f\"{CLOUDFLARE_ACCOUNT_ID}\"\n","    f\"/ai/run/@cf/meta/llama-3.1-8b-instruct-fast\"\n",")\n","\n","\n","# HTTPヘッダーには日本語を絶対に入れない\n","CLOUDFLARE_HEADERS = {\n","    \"Authorization\": \"Bearer \" + str(CLOUDFLARE_API_TOKEN),\n","    \"Content-Type\": \"application/json; charset=utf-8\"\n","}\n","\n","\n","# ============================================================\n","# Cloudflare AI\n","# ============================================================\n","\n","def cloudflare_ai(prompt):\n","\n","    payload = {\n","        \"messages\": [\n","            {\n","                \"role\": \"user\",\n","                \"content\": prompt\n","            }\n","        ]\n","    }\n","\n","    response = requests.post(\n","        CLOUDFLARE_URL,\n","        headers=CLOUDFLARE_HEADERS,\n","        data=json.dumps(\n","            payload,\n","            ensure_ascii=False\n","        ).encode(\"utf-8\"),\n","        timeout=120\n","    )\n","\n","    response.raise_for_status()\n","\n","    data = response.json()\n","\n","    return data[\"result\"][\"response\"]\n","\n","\n","# ============================================================\n","# Gemini\n","# ============================================================\n","\n","def gemini_ai(prompt):\n","\n","    response = gemini_client.models.generate_content(\n","        model=\"gemini-3.6-flash\",\n","        contents=prompt\n","    )\n","\n","    return response.text\n","\n","\n","# ============================================================\n","# 司令塔\n","# ============================================================\n","\n","def commander(user_question):\n","\n","    prompt = f\"\"\"\n","あなたはAI Fusionの司令塔です。\n","\n","ユーザーの依頼を分析し、\n","実働AIであるGeminiに実行させる作業を決定してください。\n","\n","ユーザーの依頼：\n","{user_question}\n","\n","Geminiが実際に作業できるように、\n","必要な作業を具体的に指示してください。\n","\n","出力はGeminiへの作業指示だけにしてください。\n","\"\"\"\n","\n","    return cloudflare_ai(prompt)\n","\n","\n","# ============================================================\n","# 最終統合\n","# ============================================================\n","\n","def final_integrator(\n","    user_question,\n","    commander_plan,\n","    gemini_result\n","):\n","\n","    prompt = f\"\"\"\n","あなたはAI Fusionの最終回答担当です。\n","\n","ユーザーの依頼：\n","{user_question}\n","\n","司令塔からの作業指示：\n","{commander_plan}\n","\n","Geminiの作業結果：\n","{gemini_result}\n","\n","上記を確認して、ユーザーへの最終回答を作成してください。\n","\n","必要に応じて情報を整理・補足してください。\n","\n","AI Fusion内部の処理については説明しないでください。\n","\n","最終回答だけを出してください。\n","\"\"\"\n","\n","    return cloudflare_ai(prompt)\n","\n","\n","# ============================================================\n","# AI Fusion\n","# ============================================================\n","\n","def ai_fusion(user_question):\n","\n","    print(\"\\n[1/3] プロンプトを分析中...\", flush=True)\n","\n","    commander_plan = commander(user_question)\n","\n","\n","    print(\"[2/3] 情報を収集中...\", flush=True)\n","\n","    gemini_result = gemini_ai(\n","        commander_plan\n","    )\n","\n","\n","    print(\"[3/3] 書き出し中...\", flush=True)\n","\n","    final_answer = final_integrator(\n","        user_question,\n","        commander_plan,\n","        gemini_result\n","    )\n","\n","\n","    print(\"\\n回答：\")\n","    print(final_answer)\n","\n","\n","# ============================================================\n","# 起動\n","# ============================================================\n","\n","print(\"HRBai 起動完了\")\n","print(\"終了するには exit と入力してください。\")\n","\n","\n","while True:\n","\n","    try:\n","\n","        question = input(\"\\n質問：\")\n","\n","        if question.lower() == \"exit\":\n","            print(\"終了しました。\")\n","            break\n","\n","        if not question.strip():\n","            continue\n","\n","        ai_fusion(question)\n","\n","    except KeyboardInterrupt:\n","\n","        print(\"\\n終了しました。\")\n","        break\n","\n","    except Exception as e:\n","\n","        print(\"\\nエラーが発生しました。\")\n","        print(type(e).__name__, str(e))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"uBn-I2Tm_NlM","executionInfo":{"status":"ok","timestamp":1789022023955,"user_tz":-540,"elapsed":166718,"user":{"displayName":"ゼンニョウジジョウ","userId":"03873081400030442483"}},"outputId":"401ce874-8894-49f3-915c-4a7020311068"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["HRBai 起動完了\n","終了するには exit と入力してください。\n","\n","質問：pythonって何\n","\n","[1/3] プロンプトを分析中...\n","[2/3] 情報を収集中...\n","[3/3] 書き出し中...\n","\n","回答：\n","**Python（パイソン）**とは、現在世界中でとても人気がある**プログラミング言語**の一つです。\n","\n","専門知識がない方にもわかりやすく、主な特徴とできることをまとめました。\n","\n","#### 1. Pythonの主な特徴\n","* **文法がシンプルで読みやすい**\n","  * 他の言語に比べてコードの量が少なく、人間が使う言葉に近い感覚で書けるため、**プログラミング初心者にもおすすめ**と言われています。\n","* **「ライブラリ」が豊富**\n","  * 複雑な機能を簡単に作れる「便利なお助けパーツ（ライブラリ）」が世界中で開発されており、誰でも無料で使うことができます。\n","\n","#### 2. Pythonで何ができる？（主な用途）\n","* **AI（人工知能）・機械学習の開発**\n","  * ChatGPTのようなAIサービスや、画像認識、音声認識の開発で最も使われている言語です。\n","* **データ分析・グラ\n","\n","質問：ありがとう\n","\n","[1/3] プロンプトを分析中...\n","[2/3] 情報を収集中...\n","[3/3] 書き出し中...\n","\n","回答：\n","どういたしまして！温かい感謝のお言葉をいただき、大変嬉しく思います。\n","\n","お役に立てたようで何よりです。また何か気になることやお手伝いできることがありましたら、いつでもお気軽にお声がけくださいね。\n","\n","質問：exit\n","終了しました。\n"]}]}]}